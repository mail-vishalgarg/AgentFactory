# ── Gemini (Google AI) ──────────────────────────────────────────────────────────
# Your Gemini API key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...

# Gemini model to use for agent reasoning (e.g. gemini-2.0-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# ── OpenAI (Optional fallback) ────────────────────────────────────────────────
# Your OpenAI API key (from platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# OpenAI model to use for agent reasoning
OPENAI_MODEL=gpt-4o-mini

# ── Supabase ────────────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co

# Anon (public) key — safe to use in frontend
SUPABASE_ANON_KEY=eyJ...

# Service role key — backend only, never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
# Full connection string for direct Postgres access (backend only)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Auth ────────────────────────────────────────────────────────────────────────
# Random 32+ char secret for signing JWTs — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# Token expiry in minutes
JWT_EXPIRE_MINUTES=60

# ── App ─────────────────────────────────────────────────────────────────────────
# Frontend origin — used for CORS allow-list
FRONTEND_ORIGIN=http://localhost:5173

# Backend port
PORT=8000
